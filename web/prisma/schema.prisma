generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
  invitations Invitation[]

  @@map("roles")
}

model Institution {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  apiKeyOpenai    String?  @map("api_key_openai")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  // DEPRECATED: migrado para Account (hasIntegratedAi/customAiKey/customAiModel).
  // Mantido temporariamente até a Migration C (ver plano de Account/Subscription); não ler nem escrever mais nestes campos.
  customAiKey     String?  @map("custom_ai_key")
  customAiModel   String?  @map("custom_ai_model")
  hasIntegratedAi Boolean      @default(false) @map("has_integrated_ai")
  accountId       Int          @unique @map("account_id")
  account         Account      @relation(fields: [accountId], references: [id])
  users           User[]
  aiUsageLogs     AiUsageLog[]
  invitations     Invitation[]

  @@map("institutions")
}

enum AccountType {
  INSTITUTION
  INDIVIDUAL
}

enum SubscriptionStatus {
  TRIAL
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELED
}

enum SubscriptionPlan {
  INSTITUTION_STANDARD
  INDIVIDUAL_MONTHLY
  INDIVIDUAL_VIP
}

model Account {
  id              Int          @id @default(autoincrement())
  type            AccountType
  name            String
  hasIntegratedAi Boolean      @default(false) @map("has_integrated_ai")
  customAiKey     String?      @map("custom_ai_key")
  customAiModel   String?      @map("custom_ai_model")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  institution     Institution?
  users           User[]
  subscription    Subscription?
  aiUsageLogs     AiUsageLog[]

  @@map("accounts")
}

model Subscription {
  id                   Int                @id @default(autoincrement())
  accountId            Int                @unique @map("account_id")
  status               SubscriptionStatus @default(TRIAL)
  plan                 SubscriptionPlan
  planId               Int?               @map("plan_id")
  creditsRemaining     Int?               @map("credits_remaining")
  seats                Int?
  trialEndsAt          DateTime?          @map("trial_ends_at")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  canceledAt           DateTime?          @map("canceled_at")
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  notes                String?
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  account              Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  planRef              Plan?              @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Plan {
  id            Int            @id @default(autoincrement())
  key           String         @unique
  name          String
  credits       Int?
  priceInCents  Int            @map("price_in_cents")
  isFree        Boolean        @default(false) @map("is_free")
  active        Boolean        @default(true)
  stripePriceId String?        @map("stripe_price_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  subscriptions Subscription[]

  @@map("plans")
}

model VipCode {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  createdByEmail String?   @map("created_by_email")
  note           String?
  usedByUserId   Int?      @unique @map("used_by_user_id")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  usedBy         User?     @relation(fields: [usedByUserId], references: [id])

  @@map("vip_codes")
}

model GlobalSettings {
  id            Int     @id @default(1)
  globalAiModel String? @map("global_ai_model")
  globalAiKey   String? @map("global_ai_key")
  savedAiKeys   Json?   @map("saved_ai_keys")
  usdToBrlRate  Float   @default(5.50) @map("usd_to_brl_rate")

  @@map("global_settings")
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  passwordHash   String          @map("password_hash")
  fullName       String          @map("full_name")
  roleId         Int             @map("role_id")
  institutionId  Int?            @map("institution_id")
  // Preenchido só quando o usuário é um professor independente (sem instituição).
  // Regra: institutionId e accountId são mutuamente exclusivos (ver CHECK constraint na migration).
  accountId      Int?            @map("account_id")
  // Preenchido quando o e-mail é confirmado via link de ativação. Só é exigido no
  // login de professor independente (accountId setado); demais papéis nascem já
  // confirmados (convite/criação já prova o e-mail).
  emailVerifiedAt DateTime?      @map("email_verified_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  exams          Exam[]
  questionGroups QuestionGroup[]
  questions      Question[]
  institution    Institution?    @relation(fields: [institutionId], references: [id])
  account        Account?        @relation(fields: [accountId], references: [id])
  role           Role            @relation(fields: [roleId], references: [id])
  aiUsageLogs    AiUsageLog[]
  invitationsSent Invitation[]
  redeemedVipCode VipCode?
  verificationToken EmailVerificationToken?

  @@map("users")
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model QuestionGroup {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  teacherId   Int        @map("teacher_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  teacher     User       @relation(fields: [teacherId], references: [id])
  questions   Question[]

  @@map("question_groups")
}

model Question {
  id              Int              @id @default(autoincrement())
  content         String
  type            QuestionType
  points          Float            @default(1.0)
  teacherId       Int              @map("teacher_id")
  groupId         Int?             @map("group_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  referenceAnswer String?          @map("reference_answer")
  referenceDevelopment String?     @map("reference_development")
  correctionMode  String           @default("CONCEPTUAL") @map("correction_mode")
  exams           ExamQuestion[]
  options         QuestionOption[]
  group           QuestionGroup?   @relation(fields: [groupId], references: [id])
  teacher         User             @relation(fields: [teacherId], references: [id])

  @@map("questions")
}

model QuestionOption {
  id         Int      @id @default(autoincrement())
  content    String
  isCorrect  Boolean  @default(false) @map("is_correct")
  questionId Int      @map("question_id")
  createdAt  DateTime @default(now()) @map("created_at")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

model Exam {
  id             Int              @id @default(autoincrement())
  title          String
  description    String?
  teacherId      Int              @map("teacher_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  accessCode     String?          @unique @map("access_code")
  status         ExamStatus       @default(DRAFT)
  showScore      Boolean          @default(false) @map("show_score")
  randomizeOrder Boolean          @default(false) @map("randomize_order")
  saveToBank     Boolean          @default(false) @map("save_to_bank")
  type           ExamType         @default(DIGITAL)
  answerKeyImages Json?           @map("answer_key_images")
  aiInstructions String?          @map("ai_instructions")
  totalScore     Float?           @map("total_score")
  questions      ExamQuestion[]
  submissions    ExamSubmission[]
  teacher        User             @relation(fields: [teacherId], references: [id])
  aiUsageLogs    AiUsageLog[]

  @@map("exams")
}

model ExamSubmission {
  id          String    @id @default(uuid())
  examId      Int       @map("exam_id")
  studentName String?   @map("student_name")
  studentRa   String?   @map("student_ra")
  studentExamImages Json? @map("student_exam_images")
  isPhysical  Boolean   @default(false) @map("is_physical")
  answers     Json?
  score       Float?
  startedAt   DateTime  @default(now()) @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  isExpelled  Boolean   @default(false) @map("is_expelled")
  focusLoses  Int       @default(0) @map("focus_loses")
  correctionDetails Json? @map("correction_details")
  satisfactionRating Int? @map("satisfaction_rating")
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, studentRa])
  @@map("exam_submissions")
}

model ExamQuestion {
  id         Int      @id @default(autoincrement())
  examId     Int      @map("exam_id")
  questionId Int      @map("question_id")
  order      Int      @default(0)
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("exam_questions")
}

enum ExamType {
  DIGITAL
  PHYSICAL
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  ESSAY
  MATH
  CUSTOM_HTML
}

enum ExamStatus {
  DRAFT
  WAITING
  STARTED
  FINISHED
}

model AiUsageLog {
  id               Int          @id @default(autoincrement())
  teacherId        Int          @map("teacher_id")
  // DEPRECATED: mantido em paralelo a accountId por compatibilidade com os paineis
  // de custo existentes (agrupam por institutionId). Ver plano de Account/Subscription.
  institutionId    Int?         @map("institution_id")
  accountId        Int?         @map("account_id")
  examId           Int?         @map("exam_id")
  modelUsed        String       @map("model_used")
  promptTokens     Int          @default(0) @map("prompt_tokens")
  completionTokens Int          @default(0) @map("completion_tokens")
  costInBRL        Float        @default(0.0) @map("cost_in_brl")
  createdAt        DateTime     @default(now()) @map("created_at")

  teacher     User         @relation(fields: [teacherId], references: [id])
  institution Institution? @relation(fields: [institutionId], references: [id])
  account     Account?     @relation(fields: [accountId], references: [id])
  exam        Exam?        @relation(fields: [examId], references: [id], onDelete: SetNull)

  @@map("ai_usage_logs")
}

model Invitation {
  id            String   @id @default(uuid())
  email         String   @unique
  token         String   @unique
  roleId        Int      @map("role_id")
  institutionId Int      @map("institution_id")
  inviterId     Int      @map("inviter_id")
  status        String   @default("PENDING")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  role        Role        @relation(fields: [roleId], references: [id])
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  inviter     User        @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitations")
}
